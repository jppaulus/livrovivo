# Secrets da Edge Function "ai-gateway" (configure com: supabase secrets set --env-file supabase/.env)
# Nunca coloque estas chaves dentro do aplicativo de produção.

# Google Gemini (texto das histórias, ilustrações e vozes Gemini TTS) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ElevenLabs (opcional: narração premium mais expressiva) — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key
