# Segredos do servidor (função ai-gateway). Copie para supabase/.env, preencha e envie com:
#   npx supabase secrets set --env-file supabase/.env --project-ref <ref do projeto>
# O supabase/.env fica fora do git. Nunca coloque estas chaves dentro do app.

# Texto das histórias: Claude (console.anthropic.com), créditos pré-pagos e recarga automática desligada.
ANTHROPIC_API_KEY=
# Opcional: claude-sonnet-5 (padrão) ou claude-haiku-4-5.
CLAUDE_MODELO=

# Voz dos narradores: recurso livro-vivo-voz da Azure.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Ilustrações: recurso livro-vivo-ia da Azure (publicação flux-2-pro).
AZURE_FOUNDRY_KEY=
AZURE_FOUNDRY_ENDPOINT=

# Teto de gasto do servidor inteiro por dia, em dólares (acima dele, tudo para até o dia seguinte).
TETO_DIARIO_USD=5
